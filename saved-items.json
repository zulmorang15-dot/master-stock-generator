    "htmlPreview": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Cinematic Sci-Fi Esports Endscreen</title>\r\n    <style>\r\n        /* CORE RESET & SCALING */\r\n        body, html {\r\n            margin: 0;\r\n            padding: 0;\r\n            width: 100vw;\r\n            height: 100vh;\r\n            background-color: #010103;\r\n            overflow: hidden;\r\n            font-family: 'Segoe UI', Roboto, Helvetica, sans-serif;\r\n        }\r\n\r\n        #scale-wrapper {\r\n            position: absolute;\r\n            top: 0;\r\n            left: 0;\r\n            width: 1920px;\r\n            height: 1080px;\r\n            transform-origin: top left;\r\n            overflow: hidden;\r\n        }\r\n\r\n        /* 3D CANVAS LAYER */\r\n        #webgl-canvas {\r\n            position: absolute;\r\n            top: 0;\r\n            left: 0;\r\n            width: 1920px;\r\n            height: 1080px;\r\n            z-index: 1;\r\n            pointer-events: none;\r\n        }\r\n\r\n        /* UI OVERLAY LAYER */\r\n        #ui-layer {\r\n            position: absolute;\r\n            top: 0;\r\n            left: 0;\r\n            width: 1920px;\r\n            height: 1080px;\r\n            z-index: 2;\r\n            pointer-events: none;\r\n        }\r\n\r\n        /* VIDEO PLACEHOLDERS */\r\n        .video-slot {\r\n            position: absolute;\r\n            width: 580px;\r\n            height: 326px; /* 16:9 aspect ratio */\r\n            top: 377px;\r\n            border: 6px solid #00ffff;\r\n            box-sizing: border-box;\r\n            background: rgba(0, 15, 35, 0.45);\r\n            backdrop-filter: blur(12px);\r\n            box-shadow: 0 0 40px rgba(0, 255, 255, 0.4), inset 0 0 50px rgba(0, 255, 255, 0.15);\r\n            overflow: hidden;\r\n        }\r\n        .video-slot.left { left: 100px; }\r\n        .video-slot.right { right: 100px; }\r\n\r\n        /* THICK CORNER ACCENTS */\r\n        .corner {\r\n            position: absolute;\r\n            width: 50px;\r\n            height: 50px;\r\n            border: 10px solid transparent;\r\n            z-index: 3;\r\n        }\r\n        .left .corner-tl { top: -10px; left: -10px; border-top-color: #fff; border-left-color: #fff; }\r\n        .left .corner-br { bottom: -10px; right: -10px; border-bottom-color: #fff; border-right-color: #fff; }\r\n        .right .corner-tr { top: -10px; right: -10px; border-top-color: #fff; border-right-color: #fff; }\r\n        .right .corner-bl { bottom: -10px; left: -10px; border-bottom-color: #fff; border-left-color: #fff; }\r\n\r\n        /* ANIMATED SCANLINES */\r\n        .scanline-container {\r\n            position: absolute;\r\n            top: 0; left: 0; width: 100%; height: 100%;\r\n            overflow: hidden;\r\n        }\r\n        .scanline {\r\n            position: absolute;\r\n            top: -50px;\r\n            left: 0;\r\n            width: 100%;\r\n            height: 50px;\r\n            background: linear-gradient(to bottom, transparent, rgba(0, 255, 255, 0.8), transparent);\r\n            opacity: 0.6;\r\n        }\r\n        \r\n        .pulse-overlay {\r\n            position: absolute;\r\n            top: 0; left: 0; width: 100%; height: 100%;\r\n            box-shadow: inset 0 0 60px rgba(0, 255, 255, 0);\r\n        }\r\n\r\n        /* SUBSCRIBE CENTERPIECE */\r\n        .sub-slot {\r\n            position: absolute;\r\n            width: 380px;\r\n            height: 380px;\r\n            top: 350px;\r\n            left: 770px;\r\n            border-radius: 50%;\r\n            border: 8px solid #0055ff;\r\n            box-shadow: 0 0 80px rgba(0, 85, 255, 0.6), inset 0 0 80px rgba(0, 85, 255, 0.3);\r\n            background: rgba(0, 10, 30, 0.5);\r\n            backdrop-filter: blur(15px);\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n        }\r\n        \r\n        .sub-ring-1 {\r\n            position: absolute;\r\n            width: 420px;\r\n            height: 420px;\r\n            border-radius: 50%;\r\n            border: 4px dashed #00ffff;\r\n            box-shadow: 0 0 30px rgba(0, 255, 255, 0.5);\r\n        }\r\n        \r\n        .sub-ring-2 {\r\n            position: absolute;\r\n            width: 330px;\r\n            height: 330px;\r\n            border-radius: 50%;\r\n            border: 6px solid transparent;\r\n            border-top-color: #00ffff;\r\n            border-bottom-color: #00ffff;\r\n            box-shadow: 0 0 40px rgba(0, 255, 255, 0.4);\r\n        }\r\n\r\n        .sub-core {\r\n            position: absolute;\r\n            width: 280px;\r\n            height: 280px;\r\n            border-radius: 50%;\r\n            background: radial-gradient(circle, rgba(0, 255, 255, 0.25) 0%, rgba(0, 0, 0, 0) 70%);\r\n            border: 3px solid rgba(0, 255, 255, 0.6);\r\n        }\r\n\r\n        /* CINEMATIC HUD FRAMING */\r\n        .hud-bracket {\r\n            position: absolute;\r\n            width: 80px;\r\n            height: 180px;\r\n            border: 6px solid #00ffff;\r\n            top: 450px;\r\n            box-shadow: 0 0 20px rgba(0, 255, 255, 0.5);\r\n        }\r\n        .hud-bracket.left { left: 40px; border-right: none; }\r\n        .hud-bracket.right { right: 40px; border-left: none; }\r\n\r\n        .hud-bar {\r\n            position: absolute;\r\n            height: 6px;\r\n            background: #00ffff;\r\n            box-shadow: 0 0 20px #00ffff;\r\n            left: 50%;\r\n            transform: translateX(-50%);\r\n        }\r\n        .hud-bar.top { top: 120px; width: 1200px; }\r\n        .hud-bar.bottom { bottom: 120px; width: 800px; }\r\n        \r\n        .hud-accent {\r\n            position: absolute;\r\n            width: 100px;\r\n            height: 6px;\r\n            background: #fff;\r\n            box-shadow: 0 0 20px #fff;\r\n        }\r\n        .hud-bar.top .hud-accent { top: 0; left: 0; }\r\n        .hud-bar.bottom .hud-accent { top: 0; right: 0; }\r\n\r\n    </style>\r\n\r\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js\"></script>\r\n\r\n    <script type=\"importmap\">\r\n        {\r\n            \"imports\": {\r\n                \"three\": \"https://unpkg.com/three@0.150.1/build/three.module.js\",\r\n                \"three/addons/\": \"https://unpkg.com/three@0.150.1/examples/jsm/\"\r\n            }\r\n        }\r\n    </script>\r\n</head>\r\n<body>\r\n\r\n<div id=\"scale-wrapper\">\r\n    <canvas id=\"webgl-canvas\"></canvas>\r\n    \r\n    <div id=\"ui-layer\">\r\n        \r\n        <div class=\"hud-bar top\"><div class=\"hud-accent\"></div></div>\r\n        \r\n        <div class=\"hud-bracket left\"></div>\r\n        <div class=\"video-slot left\">\r\n            <div class=\"corner corner-tl\"></div>\r\n            <div class=\"corner corner-br\"></div>\r\n            <div class=\"scanline-container\"><div class=\"scanline sl-left\"></div></div>\r\n            <div class=\"pulse-overlay po-left\"></div>\r\n        </div>\r\n\r\n        <div class=\"sub-slot\">\r\n            <div class=\"sub-ring-1 sr1\"></div>\r\n            <div class=\"sub-ring-2 sr2\"></div>\r\n            <div class=\"sub-core core\"></div>\r\n        </div>\r\n\r\n        <div class=\"video-slot right\">\r\n            <div class=\"corner corner-tr\"></div>\r\n            <div class=\"corner corner-bl\"></div>\r\n            <div class=\"scanline-container\"><div class=\"scanline sl-right\"></div></div>\r\n            <div class=\"pulse-overlay po-right\"></div>\r\n        </div>\r\n        <div class=\"hud-bracket right\"></div>\r\n\r\n        <div class=\"hud-bar bottom\"><div class=\"hud-accent\"></div></div>\r\n    </div>\r\n</div>\r\n\r\n<script type=\"module\">\r\n    import * as THREE from 'three';\r\n    import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';\r\n    import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';\r\n    import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';\r\n\r\n    /* =========================================================================\r\n       1. LAYOUT SCALING (Fixed 1920x1080 logic)\r\n       ========================================================================= */\r\n    const wrapper = document.getElementById('scale-wrapper');\r\n    function resize() {\r\n        const scale = Math.min(window.innerWidth / 1920, window.innerHeight / 1080);\r\n        wrapper.style.transform = `scale(${scale})`;\r\n    }\r\n    window.addEventListener('resize', resize);\r\n    resize();\r\n\r\n    /* =========================================================================\r\n       2. THREE.JS SCENE SETUP\r\n       ========================================================================= */\r\n    const canvas = document.getElementById('webgl-canvas');\r\n    const renderer = new THREE.WebGLRenderer({ canvas, antialias: false, powerPreference: \"high-performance\" });\r\n    renderer.setSize(1920, 1080);\r\n    renderer.setPixelRatio(1.0); // Kept at 1.0 for heavy bloom performance\r\n    renderer.toneMapping = THREE.ReinhardToneMapping;\r\n\r\n    const scene = new THREE.Scene();\r\n    scene.fog = new THREE.FogExp2(0x010105, 0.0006);\r\n\r\n    // Perspective matches 2D overlay nicely\r\n    const camera = new THREE.PerspectiveCamera(60, 1920 / 1080, 1, 5000);\r\n    camera.position.set(0, 0, 800);\r\n\r\n    /* =========================================================================\r\n       3. POST-PROCESSING (High-Impact Bloom)\r\n       ========================================================================= */\r\n    const renderScene = new RenderPass(scene, camera);\r\n    const bloomPass = new UnrealBloomPass(new THREE.Vector2(1920, 1080), 2.2, 0.5, 0.1);\r\n    \r\n    const composer = new EffectComposer(renderer);\r\n    composer.addPass(renderScene);\r\n    composer.addPass(bloomPass);\r\n\r\n    /* =========================================================================\r\n       4. CINEMATIC 3D ASSETS\r\n       ========================================================================= */\r\n    \r\n    // A. Massive Center Holographic Rings (Anchoring the Subscribe Button)\r\n    const centerGroup = new THREE.Group();\r\n    scene.add(centerGroup);\r\n\r\n    const cyanMat = new THREE.MeshBasicMaterial({ color: 0x00ffff, wireframe: true, transparent: true, opacity: 0.8 });\r\n    const blueMat = new THREE.MeshBasicMaterial({ color: 0x0033ff, wireframe: true });\r\n    const solidCyan = new THREE.MeshBasicMaterial({ color: 0x00ffff });\r\n\r\n    // Outer massive ring\r\n    const ringGeo1 = new THREE.TorusGeometry(380, 15, 8, 64);\r\n    const ringMesh1 = new THREE.Mesh(ringGeo1, cyanMat);\r\n    centerGroup.add(ringMesh1);\r\n\r\n    // Inner heavy segmented gear\r\n    const ringGeo2 = new THREE.TorusGeometry(320, 40, 4, 12);\r\n    const ringMesh2 = new THREE.Mesh(ringGeo2, blueMat);\r\n    centerGroup.add(ringMesh2);\r\n\r\n    // Floating particles around center\r\n    const ringGeo3 = new THREE.TorusGeometry(450, 2, 8, 100);\r\n    const ringMesh3 = new THREE.Points(ringGeo3, new THREE.PointsMaterial({ color: 0x00ffff, size: 4 }));\r\n    centerGroup.add(ringMesh3);\r\n\r\n    // B. Moving Cyberpunk Grid Environment (Floor & Ceiling)\r\n    const gridHelperBottom = new THREE.GridHelper(6000, 120, 0x00aaff, 0x001133);\r\n    gridHelperBottom.position.y = -400;\r\n    scene.add(gridHelperBottom);\r\n\r\n    const gridHelperTop = new THREE.GridHelper(6000, 120, 0x00aaff, 0x001133);\r\n    gridHelperTop.position.y = 400;\r\n    scene.add(gridHelperTop);\r\n\r\n    // C. Massive Foreground Energy Sweeps (Z-Axis Light Trails)\r\n    const trailsGroup = new THREE.Group();\r\n    scene.add(trailsGroup);\r\n    \r\n    const trails = [];\r\n    const trailGeo = new THREE.BoxGeometry(8, 8, 400);\r\n    for(let i=0; i<30; i++) {\r\n        // Mix of Cyan and Electric Blue trails\r\n        const mat = new THREE.MeshBasicMaterial({ color: Math.random() > 0.5 ? 0x00ffff : 0x0044ff });\r\n        const trail = new THREE.Mesh(trailGeo, mat);\r\n        \r\n        // Spread them across the massive 1920 space\r\n        trail.position.x = (Math.random() - 0.5) * 2500;\r\n        trail.position.y = (Math.random() - 0.5) * 1200;\r\n        trail.position.z = (Math.random() - 0.5) * 3000;\r\n        \r\n        trails.push(trail);\r\n        trailsGroup.add(trail);\r\n    }\r\n\r\n    // D. Large Rotating Geometric Chunks (Side Parallax)\r\n    const geoChunks = new THREE.Group();\r\n    scene.add(geoChunks);\r\n    const octaGeo = new THREE.OctahedronGeometry(80, 0);\r\n    \r\n    const chunk1 = new THREE.Mesh(octaGeo, cyanMat);\r\n    chunk1.position.set(-800, 200, 200);\r\n    geoChunks.add(chunk1);\r\n\r\n    const chunk2 = new THREE.Mesh(octaGeo, cyanMat);\r\n    chunk2.position.set(800, -200, 100);\r\n    geoChunks.add(chunk2);\r\n\r\n\r\n    /* =========================================================================\r\n       5. GSAP UI ANIMATIONS\r\n       ========================================================================= */\r\n    \r\n    // Rotating Subscribe Rings\r\n    gsap.to(\".sr1\", { rotation: 360, duration: 20, repeat: -1, ease: \"none\" });\r\n    gsap.to(\".sr2\", { rotation: -360, duration: 15, repeat: -1, ease: \"none\" });\r\n    \r\n    // Pulsing Core\r\n    gsap.to(\".core\", { scale: 1.08, boxShadow: \"0 0 60px rgba(0, 255, 255, 0.8)\", duration: 1.5, yoyo: true, repeat: -1, ease: \"sine.inOut\" });\r\n\r\n    // Video Slot Scanning Lines\r\n    gsap.to(\".sl-left\", { top: \"350px\", duration: 3, repeat: -1, ease: \"linear\" });\r\n    gsap.to(\".sl-right\", { top: \"350px\", duration: 3, delay: 1.5, repeat: -1, ease: \"linear\" });\r\n\r\n    // Inner Pulse on Video Slots\r\n    gsap.to([\".po-left\", \".po-right\"], { \r\n        boxShadow: \"inset 0 0 80px rgba(0, 255, 255, 0.3)\", \r\n        duration: 2, yoyo: true, repeat: -1, ease: \"sine.inOut\" \r\n    });\r\n\r\n    // Outer thick border breathing\r\n    gsap.to(\".video-slot\", {\r\n        borderColor: \"#00b3b3\",\r\n        boxShadow: \"0 0 60px rgba(0, 255, 255, 0.6), inset 0 0 50px rgba(0, 255, 255, 0.2)\",\r\n        duration: 1.5, yoyo: true, repeat: -1, ease: \"sine.inOut\"\r\n    });\r\n\r\n    // HUD Bar Accents Sliding\r\n    gsap.to(\".hud-bar.top .hud-accent\", { left: \"1100px\", duration: 4, repeat: -1, ease: \"power2.inOut\", yoyo: true });\r\n    gsap.to(\".hud-bar.bottom .hud-accent\", { right: \"700px\", duration: 4, repeat: -1, ease: \"power2.inOut\", yoyo: true });\r\n\r\n\r\n    /* =========================================================================\r\n       6. THREE.JS ANIMATION LOOP\r\n       ========================================================================= */\r\n    const clock = new THREE.Clock();\r\n\r\n    function animate() {\r\n        requestAnimationFrame(animate);\r\n        const time = clock.getElapsedTime();\r\n\r\n        // 1. Center Hologram Rotations\r\n        ringMesh1.rotation.z = time * 0.3;\r\n        ringMesh1.rotation.x = Math.sin(time * 0.5) * 0.3;\r\n        \r\n        ringMesh2.rotation.z = -time * 0.5;\r\n        ringMesh2.rotation.y = Math.cos(time * 0.4) * 0.2;\r\n\r\n        ringMesh3.rotation.z = time * 0.1;\r\n\r\n        // 2. Continuous Environment Forward Motion (Grid)\r\n        // Modulo 120 keeps it seamlessly looping based on the grid spacing\r\n        const speed = 400;\r\n        gridHelperBottom.position.z = (time * speed) % 120;\r\n        gridHelperTop.position.z = (time * speed) % 120;\r\n\r\n        // 3. High-Speed Energy Trails (Z-Axis wrapping)\r\n        trails.forEach(trail => {\r\n            trail.position.z += 60; // Fast movement towards camera\r\n            if (trail.position.z > 1200) {\r\n                // Reset far back when it passes the camera\r\n                trail.position.z = -2500;\r\n                trail.position.x = (Math.random() - 0.5) * 2500;\r\n                trail.position.y = (Math.random() - 0.5) * 1200;\r\n            }\r\n        });\r\n\r\n        // 4. Parallax Foreground Geometries\r\n        chunk1.rotation.x += 0.01;\r\n        chunk1.rotation.y += 0.02;\r\n        chunk1.position.y = 200 + Math.sin(time) * 50;\r\n\r\n        chunk2.rotation.x -= 0.02;\r\n        chunk2.rotation.y -= 0.01;\r\n        chunk2.position.y = -200 + Math.cos(time) * 50;\r\n\r\n        // 5. Immersive Cinematic Camera Drift\r\n        camera.position.x = Math.sin(time * 0.4) * 60;\r\n        camera.position.y = Math.cos(time * 0.3) * 40;\r\n        camera.lookAt(0, 0, 0);\r\n\r\n        // Render with Bloom\r\n        composer.render();\r\n    }\r\n\r\n    animate();\r\n</script>\r\n</body>\r\n</html>\r\n",
