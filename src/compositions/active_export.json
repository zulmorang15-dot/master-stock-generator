      "htmlCode": "<html>\n<head>\n<style>\nbody {\n  margin: 0;\n  padding: 0;\n  width: 100vw;\n  height: 100vh;\n  overflow: hidden;\n  background-color: #000000;\n}\n\n.logo {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  font-size: 100px;\n  font-weight: bold;\n  color: #ff0000;\n  opacity: 0;\n  animation: logo-intro 5s infinite;\n}\n\n@keyframes logo-intro {\n  0% {\n    opacity: 0;\n    transform: translate(-50%, -50%) scale(0);\n  }\n  50% {\n    opacity: 1;\n    transform: translate(-50%, -50%) scale(1);\n  }\n  100% {\n    opacity: 0;\n    transform: translate(-50%, -50%) scale(0);\n  }\n}\n</style>\n</head>\n<body>\n<div class=\"logo\">LOGO</div>\n<script>\nlet isPlaying = true;\nlet animationStartTime = performance.now();\nlet logo = document.querySelector('.logo');\nlet animationDuration = 5000;\n\nfunction updateAnimation(progress) {\n  logo.style.opacity = Math.max(0, Math.min(1, Math.sin(progress * Math.PI)));\n  logo.style.transform = `translate(-50%, -50%) scale(${Math.max(0, Math.min(1, Math.sin(progress * Math.PI)))})`;\n}\n\nfunction animate() {\n  if (!isPlaying) return;\n  let currentTime = performance.now();\n  let progress = (currentTime - animationStartTime) % animationDuration / animationDuration;\n  updateAnimation(progress);\n  requestAnimationFrame(animate);\n}\n\nanimate();\n\nwindow.setAnimationProgress = function(pct) {\n  updateAnimation(pct);\n};\n\nwindow.setPlayState = function(isPlayingFlag) {\n  isPlaying = isPlayingFlag;\n  if (isPlayingFlag) {\n    animationStartTime = performance.now() - (animationDuration * (performance.now() - animationStartTime) % animationDuration);\n    animate();\n  }\n};\n</script>\n</body>\n</html>",
